# MiniMax
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TEXT_MODEL=MiniMax-M2.5
MINIMAX_IMAGE_MODEL=image-01

# Server
PORT=3332
CORS_ORIGIN=http://localhost:3211
PUBLIC_URL=http://localhost:3332

# Database
DATABASE_URL="file:./dev.db"

# Auth — generate secrets with: openssl rand -hex 48
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Superadmin (seed only — there is no signup route)
SUPERADMIN_EMAIL=admin@wasel.local
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=change_me_at_least_10_chars
SUPERADMIN_RESET_PASSWORD=false
